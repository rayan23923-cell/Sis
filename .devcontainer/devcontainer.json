{
    // A one-click preview of SIS on GitHub Codespaces: PHP 8.3, Node 22, SQLite and the demo data.
    // Open it from the repository's «Code → Codespaces» button, or from a pull request's branch.
    "name": "SIS preview",
    "build": { "dockerfile": "Dockerfile" },
    "features": {
        "ghcr.io/devcontainers/features/node:1": { "version": "22" }
    },
    "hostRequirements": { "cpus": 2, "memory": "4gb" },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "postStartCommand": "bash .devcontainer/serve.sh",
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": { "label": "SIS", "onAutoForward": "openBrowser" }
    },
    "customizations": {
        "codespaces": { "openFiles": [".devcontainer/README.md"] }
    }
}

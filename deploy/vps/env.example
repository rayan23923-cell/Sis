# deploy.sh copies this to the repo root on the VPS as `.env` with fresh secrets (never commit the real one).
APP_NAME="نظام معلومات الطلبة"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sis.azoclinic.duckdns.org
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Baghdad

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sis
DB_USERNAME=sis
DB_PASSWORD=
# Used only by the MariaDB container on first start.
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@azoclinic.duckdns.org"
MAIL_FROM_NAME="${APP_NAME}"

# Shown under the system name. Staging runs with demo data (two colleges, 120 students).
SIS_UNIVERSITY_NAME="بيئة تجريبية"
SIS_ADMIN_EMAIL=admin@sis.local
SIS_DEMO_DATA=true

VITE_APP_NAME="${APP_NAME}"

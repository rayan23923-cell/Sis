<?xml version="1.0" encoding="utf-8"?>
<!-- The university's offline server uses plain http by IP, or https with its own certificate
     authority, which the user installs from the server's /setup page (hence user certificates). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>

APP_NAME="نظام معلومات الطلبة"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Baghdad

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3309
DB_DATABASE=sis
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=480
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# The university's name on documents; the administrator can change it later.
SIS_UNIVERSITY_NAME="الجامعة"
SIS_ADMIN_EMAIL=admin@sis.local
# No demo students on a real installation.
SIS_DEMO_DATA=false
# HSTS stays off: devices on the network reach the server by IP and by a local name with its own certificate.
SIS_HSTS=false

# Online payment gateways need the internet; they stay off unless their merchant settings are added here.
PAYMENTS_SANDBOX=false
